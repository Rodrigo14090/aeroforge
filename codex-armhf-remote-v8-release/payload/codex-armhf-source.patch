+                    vec![],
+                ),
+                (
+                    compiler.syscall_table.get_syscall_nr("futex").unwrap(),
+                    vec![
+                        SeccompRule::new(vec![
+                            Cond::new(2, Dword, Le, 65).unwrap(),
+                            Cond::new(1, Qword, Ne, 80).unwrap(),
