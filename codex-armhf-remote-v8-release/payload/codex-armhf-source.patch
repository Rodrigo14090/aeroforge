+#[test]
+fn test_gt_operator() {
+    // check use case for DWORD
+    let rules = vec![(
+        libc::SYS_ioctl,
+        vec![SeccompRule::new(vec![Cond::new(1, Dword, Gt, KVM_GET_PIT2).unwrap()]).unwrap()],
