+                                    "val": 65,
+                                    "comment": "dummy comment"
+                                }
+                            ]
+                        }
+                    ]
+                }
+            }
+            "#;
+            // safe because we know the string is UTF-8
+
+            let mut filters = HashMap::new();
+            filters.insert(
+                "thread_1".to_string(),
+                SeccompFilter::new(
